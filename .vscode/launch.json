{
  // F5 starts the dev server and opens the game in Chrome with the debugger attached
  // (breakpoints in src/*.ts work).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run in Chrome (with debugger)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      // Only load source maps for our own code; some packages (e.g. @capacitor/core) reference
      // .map files they don't ship, which would spam "Could not read source map" warnings.
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "preLaunchTask": "dev: run in browser"
    }
  ]
}
