# Copy to .env.production and fill in the real values before a release build.
# With VITE_ADS_TESTING=false the app uses the unit IDs below instead of Google's test IDs.
# Create the units in the AdMob console: Apps -> your app -> Ad units -> Rewarded.
VITE_ADS_TESTING=false
VITE_ADMOB_REWARDED_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
VITE_ADMOB_REWARDED_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
